{% doc %}
  @prompt
    A heading with an animated glowing effect
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-glow-heading-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.15;
    text-align: {{ block.settings.alignment }};
    text-shadow: 0 0 {{ block.settings.glow_strength }}px {{ block.settings.glow_color }}, 0 0 {{ block.settings.glow_strength | times: 2 }}px {{ block.settings.glow_color }};
    animation: ai-glow-pulse-{{ ai_gen_id }} {{ block.settings.pulse_duration }}s ease-in-out infinite alternate;
  }

  @keyframes ai-glow-pulse-{{ ai_gen_id }} {
    from {
      text-shadow: 0 0 {{ block.settings.glow_strength | divided_by: 2 }}px {{ block.settings.glow_color }}, 0 0 {{ block.settings.glow_strength }}px {{ block.settings.glow_color }};
    }
    to {
      text-shadow: 0 0 {{ block.settings.glow_strength }}px {{ block.settings.glow_color }}, 0 0 {{ block.settings.glow_strength | times: 2 }}px {{ block.settings.glow_color }};
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-glow-heading-{{ ai_gen_id }} {
      animation: none;
    }
  }
{% endstyle %}

<h2 class="ai-glow-heading-{{ ai_gen_id }}" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>

{% schema %}
{
  "name": "Glowing heading",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "Make a statement"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F3F4F5"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Glow color",
      "default": "#D6B58C"
    },
    {
      "type": "range",
      "id": "glow_strength",
      "label": "Glow strength",
      "min": 2,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "pulse_duration",
      "label": "Pulse duration",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Glowing heading"
    }
  ],
  "tag": null,
  "class": "glowing-heading-block"
}
{% endschema %}